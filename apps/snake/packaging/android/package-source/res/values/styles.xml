<?xml version="1.0" encoding="utf-8"?>
<!-- No action bar (the game draws its own screens) and the page colour behind the first frame, so a launch is not a
     flash of the system's default window colour. The game has one look, light or dark system theme alike. -->
<resources>
    <style name="Theme.Snake" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/snake_launch_background</item>
        <item name="android:colorBackground">@color/snake_launch_background</item>
    </style>
</resources>
