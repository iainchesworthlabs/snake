{
  "name": "Toybox Pixel",
  "version": "1.0",
  "color": {
    "background": { "value": "#FFC93C", "name": "Sunshine", "use": "Screen background" },
    "ink": { "value": "#2B1D52", "name": "Night purple", "use": "Text, outlines, primary buttons, board frame" },
    "shadow": { "value": "#1A1035", "name": "Deep purple", "use": "Hard drop shadows" },
    "surface": { "value": "#FFF1D6", "name": "Cream", "use": "Panels, secondary buttons, snake stripes" },
    "accent": { "value": "#FF6B4A", "name": "Coral", "use": "Snake, selected states, highlights" },
    "boardLight": { "value": "#1F6E7A", "name": "Board teal light", "use": "Checkerboard cell" },
    "boardDark": { "value": "#1A6170", "name": "Board teal dark", "use": "Checkerboard cell" },
    "food": { "value": "#4C6BFF", "name": "Blueberry", "use": "Food body" },
    "foodHighlight": { "value": "#DDE3FF", "name": "Blueberry shine", "use": "Food highlight" },
    "leaf": { "value": "#5BD16A", "name": "Leaf", "use": "Food leaf" },
    "tongue": { "value": "#FF2E63", "name": "Tongue", "use": "Snake tongue" },
    "eye": { "value": "#FFFFFF", "name": "Eye white", "use": "Snake eyes" },
    "medalGold": { "value": "#FFC93C", "use": "Leaderboard rank 1 tile" },
    "medalSilver": { "value": "#D7DCEB", "use": "Leaderboard rank 2 tile" },
    "medalBronze": { "value": "#F0A868", "use": "Leaderboard rank 3 tile" },
    "overlay": { "value": "rgba(43,29,82,0.8)", "use": "Pause dimming over gameplay" }
  },
  "typography": {
    "family": "Pixelify Sans",
    "fallback": ["Courier New", "monospace"],
    "weights": [400, 500, 600, 700],
    "files": "design/fonts",
    "phone": {
      "scoreLarge": { "size": 46, "weight": 700 },
      "screenTitle": { "size": 34, "weight": 700 },
      "wordmark": { "size": 76, "weight": 700, "shadow": "5px 5px 0 #FF6B4A" },
      "buttonPrimary": { "size": 26, "weight": 700 },
      "buttonSecondary": { "size": 18, "weight": 700 },
      "body": { "size": 17, "weight": 600 },
      "label": { "size": 16, "weight": 500 },
      "caption": { "size": 14, "weight": 500 }
    },
    "scoreFormat": "six digits, zero padded, e.g. 000420"
  },
  "shape": {
    "outline": { "panel": 4, "control": 3, "unit": "px", "color": "ink" },
    "radius": { "chip": 8, "control": 10, "button": 14, "panel": 18, "dialog": 20, "tiltPlate": 28, "segment": 4, "head": 6, "unit": "px" },
    "dropShadow": { "small": "0 3px 0 #1A1035", "medium": "0 4px 0 #1A1035", "large": "0 6px 0 #1A1035", "note": "Hard offset only. No blur, no gradients." },
    "segmentBevel": "inset 0 -3px 0 rgba(43,29,82,0.28)",
    "minTouchTarget": 44
  },
  "board": {
    "cells": { "columns": 20, "rows": 20 },
    "checkerboard": ["boardLight", "boardDark"],
    "frame": "6px ink outline plus a 12px hard drop in shadow colour (phone)",
    "cellSize": {
      "phone": { "cell": 18, "board": 360, "viewport": "390 x 844 portrait" },
      "esp": { "cell": 27, "board": 540, "viewport": "1024 x 600 landscape (assumed)" },
      "desktop": { "cell": 32, "board": 640, "viewport": "1280 x 800 landscape" }
    },
    "scaling": "Integer scale factors only, letterboxed, so pixel edges stay crisp"
  },
  "snake": {
    "stripes": ["accent", "surface"],
    "head": "accent, rounded, two white eyes with ink pupils facing travel direction, tongue in tongue colour",
    "deathSequence": "segments flash, then pop into small particles from the tail; head shows dizzy X eyes; star bits at impact"
  },
  "motion": {
    "foodBob": { "distance": 3, "duration": "0.9s", "easing": "ease-in-out", "unit": "px at phone scale" },
    "scorePop": { "rise": 14, "duration": "1.6s", "unit": "px at phone scale" },
    "cursorBlink": { "duration": "1s", "steps": 1 },
    "reducedMotion": "All looping animation, screen shake and flashing switch off"
  },
  "tiltIndicator": {
    "plate": { "size": 140, "radius": 28, "outline": 4, "fill": "surface" },
    "deadZoneRing": { "diameter": 52, "border": "3px dashed rgba(43,29,82,0.35)" },
    "bubble": { "diameter": 26, "fill": "accent", "outline": 3 },
    "arrows": "four triangles; the active direction is solid ink, the others ink at 35% opacity"
  }
}
